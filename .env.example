# Public origin used to construct share and management links. Never derive it from Host.
APP_ORIGIN=http://127.0.0.1:3000

# Private writable directory outside this repository's public/ directory.
TADA_DATA_DIR=/var/lib/tada

# Generate two independent values with at least 32 random bytes for every environment.
SHARE_TOKEN_PEPPER=replace-with-an-independent-random-secret
MEDIA_SIGNING_SECRET=replace-with-another-independent-random-secret
